# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Значение cookie «oauth_token» с soundcloud.com (как его найти — в README, шаг 3).
# Нужен только для создания плейлиста; для поиска и --dry-run не требуется.
SOUNDCLOUD_OAUTH_TOKEN=

# Пауза между запросами к SoundCloud в секундах (не меньше 1). По умолчанию 1.5.
REQUEST_DELAY=1.5
